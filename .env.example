# Frontend (Next.js) environment — standalone from the backend.
# Only values the UI needs: where the API lives, wallet/network flags, and
# server-side auth secrets for next-auth. The backend keeps its own secrets.

# Dev server port for `pnpm dev` / `pnpm start`.
WEB_PORT=3001

# Public API the browser talks to (through the Next proxy).
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_PORT=8080

# Where the Next server-side proxy reaches the backend API.
INTERNAL_API_URL=http://localhost:8080
# Must match the backend's INTERNAL_PROXY_SECRET EXACTLY so the signed end-user
# identity verifies. Required even in local dev: the proxy strips client identity
# headers, so an empty value means every browser-session API call fails with
# "Authentication required". Use a long random string in production.
INTERNAL_PROXY_SECRET=dev-internal-proxy-secret-change-me
# Lifetime (seconds) of the signed proxy-identity token the proxy sends to the API.
INTERNAL_IDENTITY_TTL_SECONDS=300

# Which trusted edge (if any) the proxy resolves the client IP/country from, to
# sign into the backend's `x-proxy-context` (frontend audit X-1/X-2). A browser's
# own cf-ipcountry/x-forwarded-for is NEVER trusted. Values:
#   none (default) — no trusted edge (bare `next start`); no country asserted, so
#                    the backend geo gate fails CLOSED. Deploy behind an edge below.
#   cloudflare     — trust cf-ipcountry / cf-connecting-ip (Cloudflare in front).
#   vercel         — trust x-vercel-ip-country / x-real-ip.
#   xff            — trust the leftmost X-Forwarded-For as IP (no country).
# PROXY_TRUSTED_EDGE=none

# Wallet + network flags surfaced to the client bundle.
# App name shown by the Loop wallet + used as branding (client-visible).
NEXT_PUBLIC_APP_NAME=Intent Swap
# On mainnet this MUST be `loop` — the boot preflight refuses to start otherwise.
# The `dev` signer produces a forgeable dev:<sha256> value (no crypto authorization).
NEXT_PUBLIC_WALLET_PROVIDER=dev
NEXT_PUBLIC_LOOP_NETWORK=local
NEXT_PUBLIC_CANTON_NETWORK=localnet
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only auth (next-auth). Do NOT expose as NEXT_PUBLIC_*.
AUTH_SECRET=dev-auth-secret-change-me-in-production
# REQUIRED in production (enforced at boot): pin the canonical app origin so
# NextAuth derives callback/redirect URLs from it, not the inbound Host header
# (prevents host-header injection of OAuth callbacks / magic links). e.g.
# AUTH_URL=https://app.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: tighten the browser CSP `connect-src` to a SPACE-separated origin
# allowlist in production (default falls back to `https:`). Include any external
# origins the Loop wallet SDK must reach. e.g. CSP_CONNECT_SRC=https://api.example.com
# CSP_CONNECT_SRC=

# Operator admin UI (KYC whitelist / freeze-block / audit). The /api/admin/* proxy
# is gated as follows before it will reach the privileged /v1/admin/* backend:
#   1) ADMIN_UI_ENABLED must be "true" (keep false/unset in normal deployments)
#   2) the caller must have an authenticated next-auth session
#   3) MANDATORY: the operator must present the admin key, which is verified
#      constant-time against ADMIN_API_KEY here — no admin action is reachable
#      from the UI without it (the key is held in memory only, never persisted).
#   4) OPTIONAL extra layer: if ADMIN_ALLOWED_EMAILS is set (comma-separated),
#      the session email must be on it. Leave empty to gate on the key alone.
# NEVER expose these as NEXT_PUBLIC_*.
ADMIN_UI_ENABLED=false
ADMIN_API_KEY=
ADMIN_ALLOWED_EMAILS=
